        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Task name|title",
              "title": "={{ \n  (() => {\n    const clean = $json.text.replace(/```json|```/g, '').trim();\n    return JSON.parse(clean).task_name;\n  })()\n}}"
            },
            {
              "key": "Context/Details|rich_text",
              "textContent": "={{ \n  (() => {\n    const clean = $json.text.replace(/```json|```/g, '').trim();\n    return JSON.parse(clean).context;\n  })()\n}}"
            },
            {
              "key": "Deadline|date",
              "date": "={{ \n  (() => {\n    try {\n      const clean = $json.text.replace(/```json|```/g, '').trim();\n      const parsed = JSON.parse(clean);\n      if (!parsed.deadline_day || parsed.deadline_day === \"null\") return undefined;\n\n      const time = parsed.deadline_time || \"00:00\";\n      const dayStr = parsed.deadline_day.toLowerCase();\n\n      let target = $now;\n      \n      if (dayStr === 'tomorrow') {\n        target = target.plus({ days: 1 });\n      } else if (dayStr !== 'today') {\n        // Map string to standard Luxon weekday numbers (1 = Mon, 7 = Sun)\n        const daysMap = { monday: 1, tuesday: 2, wednesday: 3, thursday: 4, friday: 5, saturday: 6, sunday: 7 };\n        \n        // Strip out extra words like \"next\" to just get the day\n        const cleanDay = dayStr.replace(/next week's |next /g, \"\");\n        const targetDayNum = daysMap[cleanDay];\n        \n        if (targetDayNum) {\n          // Calculate days until the next occurrence of that weekday\n          let daysToAdd = targetDayNum - target.weekday;\n          if (daysToAdd <= 0) daysToAdd += 7; // Force it to the upcoming week if the day already passed\n          \n          target = target.plus({ days: daysToAdd });\n        }\n      }\n      \n      return `${target.toFormat('yyyy-MM-dd')}T${time}:00`;\n    } catch (e) {\n      return undefined;\n    }\n  })()\n}}",
              "timezone": "Asia/Manila"
            }
          ]
        },
